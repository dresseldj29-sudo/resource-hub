rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.owner == true; }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /groups/{groupId} {
      // Needed for joining by code in this static starter. See README for the security caveat.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner() || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members + 1);
      allow delete: if isOwner() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /servers/{serverId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Counts authenticated page visits. Only the owner can read the records.
    match /visits/{visitId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isOwner();
    }
  }
}
